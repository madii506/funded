{
  "cleanUrls": true,
  "functions": {
    "api/launch.js": { "maxDuration": 60 },
    "api/tick.js": { "maxDuration": 60 },
    "api/coins.js": { "maxDuration": 25 },
    "api/poly.js": { "maxDuration": 25 },
    "api/meta.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/m/:id", "destination": "/api/meta?id=:id" },
    { "source": "/i/:id", "destination": "/api/meta?img=:id" },
    { "source": "/c/:mint", "destination": "/index.html" },
    { "source": "/t/:name", "destination": "/index.html" },
    { "source": "/top", "destination": "/index.html" },
    { "source": "/launch", "destination": "/index.html" },
    { "source": "/coins", "destination": "/index.html" },
    { "source": "/ledger", "destination": "/index.html" },
    { "source": "/how", "destination": "/index.html" },
    { "source": "/token", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(css|js|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
